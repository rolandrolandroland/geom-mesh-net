# Python
__pycache__/
*.py[cod]
venv/
.venv/
*.egg-info/

# macOS
.DS_Store

# Simulated point patterns (5 GB, 1000 patterns).
# Regenerate with deprecated_code/tester_scripts/data_factory.py
data/
walkthroughs/walkthrough_data

# Training checkpoints and figures
example_01/checkpoints
deprecated_code/tester_scripts/checkpoints
deprecated_code/tester_scripts/checkpoints_old

# Large experiment artifacts: per-pattern feature grids, targets, masks,
# predictions and checkpoints. Regenerate with
# example_01/execute_experimental_methodology_01.py. The report, figures,
# metrics CSVs and configs under methodology_01_results/ ARE tracked.
example_01/methodology_01_results/patterns/
example_01/paper_feature_cache_02/
example_01/paper_feature_experiments_02/

# Stage 1 feature caches are regenerable in about 4 minutes:
#   PYTHONPATH=. python inference/extract_features.py --workers 7
# The .json metadata beside each cache IS tracked, since it records the config,
# timings and gate result.
inference/features/*.npz

# Fitted flow and posterior samples, regenerable in seconds:
#   PYTHONPATH=. python inference/fit_posterior.py
# The .json metadata and training history ARE tracked.
inference/posterior/*.pt
inference/posterior/*.npz

# Augmented (thinned-replicate) feature cache, ~11 min to regenerate:
#   PYTHONPATH=. python inference/augment_features.py --workers 7
inference/features/augmented_features.npz

# Reference PDFs. Published papers are not redistributed from this repo.
papers/

# Shared-point-pattern dataset (~5 GB), regenerable:
#   PYTHONPATH=. python inference/generate_shared_upp.py
data_shared_upp/

# Random-centre benchmark dataset (~5 GB), regenerable:
#   PYTHONPATH=. python reconstruction/generate_random_centres.py
# Its checksums and provenance are copied into reconstruction/benchmark/, which IS tracked.
data_random_centres/

# Personal teaching worksheets (exercise and solution notebooks), regenerable with
#   python worksheets/_build/build_worksheets.py
worksheets/

# Per-atom oracle probabilities, regenerable by reconstruction/stage0_oracle.py.
# The gate report and metadata beside them ARE tracked.
reconstruction/results/oracle/
