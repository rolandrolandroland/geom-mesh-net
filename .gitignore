# Python
__pycache__/
*.py[cod]
venv/
.venv/
*.egg-info/

# macOS
.DS_Store

# Simulated point patterns (5 GB, 1000 patterns).
# Regenerate with PYTHONPATH=. python scripts/generate_data.py
data/

# The guide notebook's five-pattern dataset and trained models. The notebook
# regenerates both when it runs; its figures under walkthrough_figures/ ARE tracked.
docs/guides/walkthrough_data/
docs/guides/trained_models/

# Training checkpoints and figures
experiments/neural_field/checkpoints
deprecated_code/checkpoints/
deprecated_code/tester_scripts/checkpoints
deprecated_code/tester_scripts/checkpoints_old

# Large experiment artifacts: per-pattern feature grids, targets, masks,
# predictions and checkpoints. Regenerate with
# experiments/neural_field/execute_experimental_methodology_01.py. The report,
# figures, metrics CSVs and configs under methodology_01_results/ ARE tracked.
experiments/neural_field/methodology_01_results/patterns/
experiments/neural_field/paper_feature_cache_02/
experiments/neural_field/paper_feature_experiments_02/

# Stage 1 feature caches are regenerable in about 4 minutes:
#   python -m experiments.inference.extract_features --workers 7
# The .json metadata beside each cache IS tracked, since it records the config,
# timings and gate result.
experiments/inference/features/*.npz

# Fitted flow and posterior samples, regenerable in seconds:
#   python -m experiments.inference.fit_posterior
# The .json metadata and training history ARE tracked.
experiments/inference/posterior/*.pt
experiments/inference/posterior/*.npz

# Reference PDFs. Published papers are not redistributed from this repo.
papers/

# Local notes that are not published.
private/

# Shared-point-pattern dataset (~5 GB), regenerable:
#   python -m experiments.inference.generate_shared_upp
data_shared_upp/

# Random-centre benchmark dataset (~5 GB), regenerable:
#   python -m experiments.reconstruction.generate_random_centres
# Its checksums and provenance are copied into experiments/reconstruction/benchmark/,
# which IS tracked.
data_random_centres/

# Stage 5 diffusion-field patterns (~0.8 GB), regenerable:
#   python -m experiments.reconstruction.generate_diffusion_patterns --split development
#   python -m experiments.reconstruction.generate_diffusion_patterns --split test
data_diffusion/

# Personal teaching worksheets (exercise and solution notebooks), regenerable with
#   python worksheets/_build/build_worksheets.py
worksheets/

# Per-atom oracle probabilities, regenerable by
#   python -m experiments.reconstruction.stage0_oracle
# The gate report and metadata beside them ARE tracked.
experiments/reconstruction/results/oracle/

# Stage 5 oracles (replay inside precipitates, the diffusion field in the matrix), regenerable by
#   python -m experiments.reconstruction.stage5_simulator
experiments/reconstruction/results/oracle_diffusion/
